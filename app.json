{
  "expo": {
    "name": "Garaj",
    "slug": "garaj",
    "version": "0.1.0",
    "scheme": "garaj",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "lk.gedaraworkshop.garaj"
    },
    "android": {
      "package": "lk.gedaraworkshop.garaj",
      "adaptiveIcon": {
        "backgroundColor": "#0e5c55",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#f5f5f1",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#101312"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Garaj uses your photos so you can add a picture of your vehicle or a bill.",
          "cameraPermission": "Garaj uses the camera so you can snap your vehicle or a bill."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0e5c55"
        }
      ],
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
